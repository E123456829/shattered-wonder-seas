<?xml version="1.0" encoding="utf-8"?>
<Mod id="codex-shattered-wonder-seas" version="1"
	xmlns="ModInfo">
	<Properties>
		<Name>LOC_MODULE_SHATTERED_WONDER_SEAS_NAME</Name>
		<Description>LOC_MODULE_SHATTERED_WONDER_SEAS_DESCRIPTION</Description>
		<Authors>Codex</Authors>
		<Package>Mod</Package>
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
		<Mod id="ged-ynamp" title="YnAMP - Yet (not) Another Map Pack"/>
	</Dependencies>
	<ActionCriteria>
		<Criteria id="always">
			<AlwaysMet></AlwaysMet>
		</Criteria>
	</ActionCriteria>
	<ActionGroups>
		<ActionGroup id="codex-shattered-wonder-seas-game" scope="game" criteria="always">
			<Properties>
				<LoadOrder>9500</LoadOrder>
			</Properties>
			<Actions>
				<UpdateDatabase>
					<Item>data/shattered-wonder-seas.xml</Item>
					<Item>data/twin-discovery-wonder-seas.xml</Item>
					<Item>data/twin-discovery-force-wonders.sql</Item>
					<Item>data/independent-low-military.xml</Item>
					<Item>data/independent-combat-bonus-gameeffects.xml</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>text/en_us/MapText.xml</Item>
					<Item locale="zh_Hans_CN">text/zh_Hans_CN/MapText.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>
		<ActionGroup id="codex-shattered-wonder-seas-shell" scope="shell" criteria="always">
			<Properties>
				<LoadOrder>2500</LoadOrder>
			</Properties>
			<Actions>
				<UpdateDatabase>
					<Item>config/config.xml</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>text/en_us/MapText.xml</Item>
					<Item locale="zh_Hans_CN">text/zh_Hans_CN/MapText.xml</Item>
				</UpdateText>
			</Actions>
		</ActionGroup>
	</ActionGroups>
	<LocalizedText>
		<File>text/en_us/ModuleText.xml</File>
		<File>text/zh_Hans_CN/ModuleText.xml</File>
	</LocalizedText>
</Mod>
